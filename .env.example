# Copy to .env and fill real values. Never commit .env.
API_KEY=replace_with_a_long_random_internal_api_key
# The Coordinator uses this same key to persist non-RAG turns in the RAG service.
RAG_API_KEY=replace_with_the_same_value_as_API_KEY
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=assistant_db
QDRANT_API_KEY=
COLLECTION_NAME=assistant_knowledge1
LLM_MODEL=qwen3:8b
LOCAL_LLM_MODEL=qwen3:8b
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=1
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_INPUT_CHARS=4000
OPENAI_MAX_CONCURRENCY=4
OPENAI_MAX_REQUESTS_PER_MINUTE=30
EMBEDDING_MODEL=qllama/bge-m3:q4_k_m
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBED_BATCH_SIZE=32
RABBITMQ_ENABLED=false
ERP_MCP_URL=http://erp-mcp:8002/mcp
ERP_MCP_BEARER_TOKEN=
# Comma-separated administrator-approved read-only tool names; align with MCP server.
# Explicit allowlist; leave blank until verified against the actual ERP MCP tool catalog.
ERP_MCP_READ_ONLY_TOOLS=
# Explicit allowlist only; write tools are never executed directly from a model response.
ERP_MCP_WRITE_TOOLS=
# Forward the user's SSO bearer token from the trusted .NET Assistant API to ERP MCP.
ERP_MCP_REQUIRE_USER_TOKEN=true
# Approval API is internal; .NET must authenticate the approver and enforce ERP approval roles.
APPROVAL_API_KEY=replace_with_a_long_random_internal_api_key
APPROVAL_TTL_SECONDS=900
APPROVAL_ALLOW_SELF_APPROVAL=false
REDIS_URL=redis://redis:6379/0

# Phase 7 deterministic guardrails (keep enabled in all environments)
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_PROMPT_CHARS=12000
GUARDRAILS_MAX_OUTPUT_CHARS=16000
GUARDRAILS_MAX_TOOL_RESULT_CHARS=12000
