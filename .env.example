# ============================================================
# ERP Smart Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in the real values.
# DO NOT commit .env to version control.
# ============================================================


# ============================================================
# ASSISTANT API (Public Gateway)
# ============================================================
# The only service exposed to clients on 127.0.0.1:8100.
# Clients must send X-API-Key header matching ASSISTANT_API_KEY.
# Leave empty ONLY for trusted private-network deployments where
# authentication is enforced upstream (e.g. reverse proxy with mTLS).
ASSISTANT_API_KEY=change-me-assistant-api-key

# Timeout (seconds) for outbound calls from Assistant API
# to Coordinator and RAG. Increase for long-running requests.
ASSISTANT_API_TIMEOUT_SECONDS=90


# ============================================================
# APPROVAL (Human-in-the-loop for ERP write operations)
# ============================================================
# Required to approve/reject ERP write operations via
# /api/v1/erp/approvals/* endpoints on the Coordinator.
# If empty, falls back to ASSISTANT_API_KEY.
# In production, use a DIFFERENT value from ASSISTANT_API_KEY
# so approval actions require a separate credential.
APPROVAL_API_KEY=change-me-approval-key

# Approval TTL in seconds (how long an approval can be pending)
APPROVAL_TTL_SECONDS=900

# Allow the same user who requested the operation to approve it.
# MUST be false in production for separation of duties.
APPROVAL_ALLOW_SELF_APPROVAL=false


# ============================================================
# POSTGRESQL (Conversations, Messages, Documents metadata)
# ============================================================
POSTGRES_USER=assistant_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=assistant_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# ============================================================
# QDRANT (Vector database for RAG)
# ============================================================
QDRANT_API_KEY=change-me-qdrant-key
COLLECTION_NAME=assistant_knowledge1


# ============================================================
# OLLAMA / LOCAL LLM
# ============================================================
LLM_MODEL=qwen3.5:9b
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_NUM_PREDICT=512
EMBEDDING_MODEL=qllama/bge-m3:q4_k_m

# Router and clarification LLM parameters
ROUTER_NUM_PREDICT=32


# ============================================================
# RAG (Chunking, Retrieval)
# ============================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBED_BATCH_SIZE=32
RAG_API_TIMEOUT_SECONDS=60


# ============================================================
# OPENAI (Optional external model)
# ============================================================
# If OPENAI_ENABLED=false, all requests stay local.
# If true, prompts are sanitized (PII masked) and rate-limited.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_RETRIES=1
OPENAI_MAX_TOKENS=800
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_INPUT_CHARS=4000
OPENAI_MAX_CONCURRENCY=4
OPENAI_MAX_REQUESTS_PER_MINUTE=30


# ============================================================
# ERP MCP SERVER (External service — ASP.NET Core or other)
# ============================================================
# The MCP server is deployed separately and is NOT part of this
# docker-compose. It must be reachable from the Coordinator on
# the assistant_network (or via a public URL).
ERP_MCP_URL=http://216.65.200.52:30001/mcp
ERP_MCP_TIMEOUT_SECONDS=30

# Service-to-service bearer token for MCP (only if MCP requires it).
# The end-user SSO token (Authorization header from client) is
# forwarded separately and takes precedence.
ERP_MCP_BEARER_TOKEN=

# Allowlists — comma or semicolon separated tool names.
# Empty means: only tools with explicit readOnlyHint=true (for reads)
# or explicit administrator allowlist (for writes).
ERP_MCP_READ_ONLY_TOOLS=
ERP_MCP_WRITE_TOOLS=

# Require a user Bearer token for every MCP call.
# MUST be true in production so that ERP enforces user RBAC.
ERP_MCP_REQUIRE_USER_TOKEN=true


# ============================================================
# RABBITMQ (Event publishing for analytics)
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=LogAi
RABBITMQ_QUEUE=LogAi
RABBITMQ_ROUTING_KEY=message.created
RABBITMQ_ENABLED=false


# ============================================================
# GUARDRAILS (Input/output safety)
# ============================================================
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_PROMPT_CHARS=12000
GUARDRAILS_MAX_OUTPUT_CHARS=16000
GUARDRAILS_MAX_TOOL_RESULT_CHARS=12000


# ============================================================
# CLARIFICATION (Rule-based follow-up questions)
# ============================================================
CLARIFICATION_ENABLED=true
CLARIFICATION_MAX_QUESTIONS=2
CLARIFICATION_NUM_PREDICT=256
CLARIFICATION_HISTORY_MAX_TURNS=3


# ============================================================
# SSE STREAMING
# ============================================================
# Heartbeat interval (seconds) between ping events.
# Should be less than typical proxy idle timeouts (usually 60s).
SSE_HEARTBEAT_INTERVAL_SECONDS=15
SSE_STREAM_TIMEOUT_SECONDS=300


# ============================================================
# NETWORK / SERVICE URLS
# ============================================================
# These are set inside docker-compose.yml and do NOT need to
# appear here unless you override them. Documented for clarity.
#
# COORDINATOR_URL=http://coordinator:8101
# RAG_API_URL=http://fastapi:8102
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# OLLAMA_URL=http://ollama:11434